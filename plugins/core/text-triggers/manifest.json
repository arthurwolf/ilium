{
  "api": "ilium:plugin@0.1.0",
  "id": "ilium.core.text-triggers",
  "name": "Text triggers",
  "version": "0.1.0",
  "publisher": "Ilium",
  "description": "Text triggers are regular-expression rules that watch terminal output and send text to the pane that printed it.",
  "license": "MIT",
  "server": {
    "entry": "server.wasm",
    "world": "ilium:server/base@0.1.0"
  },
  "client": {
    "entry": "client.wasm",
    "world": "ilium:client/base@0.1.0"
  },
  "capabilities": {
    "server": [
      "terminal.output-filter",
      "terminal.write",
      "settings.write-kernel:text-triggers",
      "extensions.provide:ilium.core.text-triggers/rule-packs",
      "extensions.provide:ilium.core.text-triggers/before-fire",
      "terminal.read-screen",
      "terminal.read-cells",
      "tree.read"
    ],
    "client": [
      "ui.panels"
    ]
  },
  "contributes": {
    "extension_points": [
      {
        "id": "rule-packs",
        "kind": "collect",
        "title": "Rule packs",
        "entry_schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "pattern": {
                    "type": "string"
                  },
                  "reply": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "pattern",
                  "reply",
                  "enabled"
                ]
              }
            }
          },
          "required": [
            "id",
            "title",
            "rules"
          ]
        },
        "risk": "high",
        "max_entries": 64,
        "dynamic": false,
        "version": "0.1.0"
      },
      {
        "id": "before-fire",
        "kind": "hook",
        "mode": "veto",
        "title": "Before a rule fires",
        "payload_schema": {
          "type": "object",
          "properties": {
            "rule": {
              "type": "string"
            },
            "pane": {
              "type": "string"
            },
            "match": {
              "type": "string"
            },
            "reply_length": {
              "type": "integer"
            }
          },
          "required": [
            "rule",
            "pane",
            "match",
            "reply_length"
          ]
        },
        "risk": "high",
        "deadline_ms": 20,
        "max_handlers": 8,
        "version": "0.1.0"
      }
    ],
    "panels": [
      {
        "id": "rules",
        "title": "Text triggers"
      }
    ]
  },
  "activation": [
    "startup",
    "view:ilium.core.text-triggers/rules"
  ],
  "replaceable": true,
  "surface": [
    "services:test-rule",
    "points:rule-packs",
    "points:before-fire",
    "topics:fired"
  ],
  "limits_tier": "first-party"
}
