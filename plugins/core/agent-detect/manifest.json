{
  "api": "ilium:plugin@0.1.0",
  "id": "ilium.core.agent-detect",
  "name": "Agent detect",
  "version": "0.1.0",
  "publisher": "Ilium",
  "description": "The Agent detection plugin has the id ilium.core.agent-detect and runs on both sides.",
  "license": "MIT",
  "server": {
    "entry": "server.wasm",
    "world": "ilium:server/base@0.1.0",
    "exports": [
      "detector"
    ]
  },
  "client": {
    "entry": "client.wasm",
    "world": "ilium:client/base@0.1.0",
    "exports": [
      "views"
    ]
  },
  "capabilities": {
    "server": [
      "agent.read",
      "agent.signatures",
      "tree.decorate",
      "panes.read",
      "terminal.write",
      "settings.write-kernel:agent-monitoring",
      "extensions.provide:ilium.core.agent-detect/activity-rules",
      "extensions.provide:ilium.core.agent-detect/classify"
    ],
    "client": [
      "agent.read",
      "ui.panels"
    ]
  },
  "activation": [
    "startup",
    "view:agent-detect.panel"
  ],
  "contributes": {
    "extension_points": [
      {
        "id": "activity-rules",
        "kind": "collect",
        "title": "Activity rules",
        "entry_schema": {
          "type": "object",
          "required": [
            "id",
            "signature",
            "state",
            "regex",
            "region"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "signature": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "regex": {
              "type": "string"
            },
            "region": {
              "type": "string",
              "enum": [
                "last-lines",
                "status-row",
                "whole-screen"
              ]
            }
          }
        },
        "risk": "standard",
        "max_entries": 64,
        "dynamic": false,
        "version": "0.1.0"
      },
      {
        "id": "classify",
        "kind": "hook",
        "mode": "transform",
        "title": "Classify",
        "payload_schema": {
          "type": "object",
          "required": [
            "pane",
            "signature",
            "state",
            "reason"
          ],
          "properties": {
            "pane": {
              "type": "string"
            },
            "signature": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "reply_schema": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string"
            }
          }
        },
        "risk": "high",
        "deadline_ms": 20,
        "max_handlers": 8,
        "version": "0.1.0"
      }
    ],
    "signatures": [
      {
        "id": "example-agent",
        "process_names": [
          "example-agent"
        ],
        "aliases": [
          "example"
        ],
        "icon": "robot"
      }
    ],
    "panels": [
      {
        "id": "panel",
        "title": "Agent detection",
        "modal": false
      }
    ],
    "decoration_slots": [
      {
        "id": "activity",
        "placement": "icon",
        "priority": 90
      },
      {
        "id": "goal",
        "placement": "badge",
        "priority": 80
      }
    ],
    "display_modes": [
      {
        "id": "attention",
        "title": "Attention",
        "icon": "bell",
        "slot": "activity",
        "hide_unmarked": true
      }
    ]
  },
  "limits_tier": "first-party"
}
