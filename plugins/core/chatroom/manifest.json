{
  "api": "ilium:plugin@0.1.0",
  "id": "ilium.core.chatroom",
  "name": "Chatroom",
  "version": "0.1.0",
  "publisher": "Ilium",
  "description": "The Chatroom is a shared message board for the agents of one project and for the user.",
  "license": "MIT",
  "server": {
    "entry": "server.wasm",
    "world": "ilium:server/base@0.1.0",
    "exports": [
      "virtual-rows-provider"
    ]
  },
  "client": {
    "entry": "client.wasm",
    "world": "ilium:client/base@0.1.0",
    "exports": [
      "views"
    ]
  },
  "capabilities": {
    "server": [
      "tree.decorate",
      "tree.write",
      "fs.read:project",
      "fs.write:project",
      "fs.watch:project",
      "topics.subscribe:chatroom",
      "services.use:ilium.core.agent-setup",
      "cli.contribute",
      "extensions.provide:ilium.core.chatroom/before-post"
    ],
    "client": [
      "topics.subscribe:chatroom",
      "ui.panels",
      "extensions.provide:ilium.core.chatroom/message-renderers"
    ]
  },
  "activation": [
    "startup",
    "topic:chatroom"
  ],
  "limits_tier": "first-party",
  "contributes": {
    "cli": [
      {
        "name": "chat",
        "summary": "Project chatroom: init, send, context, tail",
        "output": "text",
        "stdin": "none",
        "requires_server": false
      }
    ],
    "extension_points": [
      {
        "id": "before-post",
        "kind": "hook",
        "mode": "transform",
        "title": "Change a message before it is written to the room",
        "payload_schema": {
          "type": "object",
          "properties": {
            "author": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            }
          },
          "required": [
            "author",
            "text",
            "kind"
          ]
        },
        "reply_schema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        "risk": "high",
        "deadline_ms": 20,
        "max_handlers": 8,
        "version": "0.1.0"
      },
      {
        "id": "message-renderers",
        "kind": "collect",
        "title": "Draw a message kind in a special way",
        "entry_schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "view": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind",
            "view"
          ]
        },
        "risk": "standard",
        "max_entries": 64,
        "dynamic": false,
        "version": "0.1.0"
      }
    ]
  }
}
