{
  "api": "ilium:plugin@0.1.0",
  "id": "ilium.core.fleet",
  "name": "Fleet",
  "version": "0.1.0",
  "publisher": "Ilium",
  "description": "The Fleet plugin has the id ilium.core.fleet and runs on both sides.",
  "license": "MIT",
  "server": {
    "entry": "server.wasm",
    "world": "ilium:server/base@0.1.0"
  },
  "client": {
    "entry": "client.wasm",
    "world": "ilium:client/base@0.1.0"
  },
  "capabilities": {
    "server": [
      "cli.contribute",
      "sessions.cross",
      "http-api.route:/create_agent",
      "terminal.write",
      "panes.create",
      "panes.read",
      "agent.read",
      "messages.peer:ilium.core.notifications",
      "services.use:ilium.core.cost/usage",
      "settings.write-kernel:api",
      "extensions.provide:ilium.core.fleet/selectors",
      "extensions.provide:ilium.core.fleet/before-broadcast"
    ],
    "client": [
      "ui.panels"
    ]
  },
  "activation": [
    "cli:panes",
    "cli:broadcast",
    "http:/create_agent",
    "service:broadcast",
    "command:ask-for-update"
  ],
  "contributes": {
    "cli": [
      {
        "name": "panes",
        "summary": "List panes in every session",
        "output": "jsonl",
        "requires_server": true
      },
      {
        "name": "broadcast",
        "summary": "Send a line to agents",
        "output": "jsonl",
        "requires_server": true,
        "argument_groups": [
          "pane-selector"
        ]
      },
      {
        "name": "new-pane",
        "summary": "Create a pane",
        "output": "mixed",
        "requires_server": true
      }
    ],
    "http_routes": [
      {
        "method": "POST",
        "path": "/create_agent"
      }
    ],
    "commands": [
      {
        "id": "ask-for-update",
        "title": "Ask for update"
      }
    ],
    "extension_points": [
      {
        "id": "selectors",
        "kind": "collect",
        "title": "Selectors",
        "entry_schema": {
          "type": "object",
          "required": [
            "id",
            "title",
            "rule"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "rule": {
              "type": "object"
            }
          }
        },
        "risk": "standard",
        "max_entries": 64,
        "dynamic": false,
        "version": "0.1.0"
      },
      {
        "id": "before-broadcast",
        "kind": "hook",
        "mode": "transform",
        "title": "Before broadcast",
        "payload_schema": {
          "type": "object",
          "required": [
            "message",
            "targets",
            "source"
          ],
          "properties": {
            "message": {
              "type": "string"
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source": {
              "type": "string"
            }
          }
        },
        "reply_schema": {
          "type": "object",
          "required": [
            "message"
          ],
          "properties": {
            "message": {
              "type": "string"
            }
          }
        },
        "risk": "high",
        "deadline_ms": 20,
        "max_handlers": 8,
        "version": "0.1.0"
      }
    ]
  },
  "limits_tier": "first-party"
}
