{
  "api": "ilium:plugin@0.1.0",
  "id": "ilium.core.smart-copy",
  "name": "Smart copy",
  "version": "0.1.0",
  "publisher": "Ilium",
  "description": "The Smart Copy plugin (ilium.core.smart-copy, side both) owns selection and copying in terminal panes: mouse selection of regions, the terminal right-click menu, Smart Copy light (paths, commands and hashes recognised from cell styles) and Smart Copy with the inference model choosing semantic regions.",
  "license": "MIT",
  "server": {
    "entry": "server.wasm",
    "world": "ilium:server/base@0.1.0"
  },
  "client": {
    "entry": "client.wasm",
    "world": "ilium:client/base@0.1.0"
  },
  "capabilities": {
    "server": [
      "terminal.read-cells",
      "terminal.read-screen",
      "inference",
      "extensions.provide:ilium.core.smart-copy/recognisers",
      "extensions.provide:ilium.core.smart-copy/after-copy"
    ],
    "client": [
      "terminal.read-screen",
      "terminal.pointer",
      "clipboard.write",
      "inference"
    ]
  },
  "activation": [
    "command:ilium.core.smart-copy/smart-copy"
  ],
  "contributes": {
    "context_menu": [
      {
        "id": "smart-copy",
        "title": "Smart Copy",
        "command": "smart-copy",
        "target": "terminal"
      }
    ],
    "extension_points": [
      {
        "id": "recognisers",
        "kind": "collect",
        "title": "Teach Smart Copy a new kind of structure to select",
        "entry_schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "regex": {
              "type": "string"
            },
            "multiline": {
              "type": "boolean"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind",
            "regex",
            "multiline",
            "label"
          ]
        },
        "max_entries": 64,
        "dynamic": false,
        "version": "0.1.0"
      },
      {
        "id": "after-copy",
        "kind": "hook",
        "mode": "transform",
        "title": "Change the copied text before it reaches the clipboard",
        "payload_schema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "pane": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "kind",
            "pane"
          ]
        },
        "reply_schema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        "risk": "high",
        "deadline_ms": 20,
        "max_handlers": 8,
        "version": "0.1.0"
      }
    ],
    "commands": [
      {
        "id": "smart-copy",
        "title": "Smart Copy"
      }
    ]
  },
  "replaceable": true,
  "surface": [
    "points:recognisers",
    "points:after-copy",
    "topics:copied",
    "commands:smart-copy"
  ],
  "limits_tier": "first-party"
}
