{
  "api": "ilium:plugin@0.1.0",
  "id": "ilium.core.sessions",
  "name": "Sessions",
  "version": "0.1.0",
  "publisher": "Ilium",
  "description": "A session is one project's tree of groups and panes together with the processes that run in it.",
  "license": "MIT",
  "server": {
    "entry": "server.wasm",
    "world": "ilium:server/base@0.1.0"
  },
  "client": {
    "entry": "client.wasm",
    "world": "ilium:client/base@0.1.0"
  },
  "capabilities": {
    "server": [
      "panes.read",
      "panes.lifecycle",
      "tree.restructure",
      "agent.read",
      "settings.write-kernel:session",
      "extensions.provide:ilium.core.sessions/snapshot-sections",
      "extensions.provide:ilium.core.sessions/before-restore"
    ]
  },
  "contributes": {
    "extension_points": [
      {
        "id": "snapshot-sections",
        "kind": "collect",
        "title": "Snapshot sections",
        "entry_schema": {
          "type": "object",
          "required": [
            "id",
            "max_bytes"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "max_bytes": {
              "type": "integer"
            }
          }
        },
        "risk": "standard",
        "max_entries": 64,
        "dynamic": false,
        "version": "0.1.0"
      },
      {
        "id": "before-restore",
        "kind": "hook",
        "mode": "observe",
        "title": "Before restore",
        "payload_schema": {
          "type": "object",
          "required": [
            "session",
            "pane_count"
          ],
          "properties": {
            "session": {
              "type": "string"
            },
            "pane_count": {
              "type": "integer"
            }
          }
        },
        "risk": "standard",
        "deadline_ms": 20,
        "max_handlers": 8,
        "version": "0.1.0"
      }
    ]
  },
  "activation": [
    "startup",
    "view:sessions.list"
  ],
  "replaceable": false,
  "limits_tier": "first-party"
}
