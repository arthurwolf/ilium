{
  "api": "ilium:plugin@0.1.0",
  "id": "ilium.core.worktrees",
  "name": "Worktrees",
  "version": "0.1.0",
  "publisher": "Ilium",
  "description": "A worktree agent works in its own Git worktree, a second checkout of the repository on its own branch, so several agents can change the same project without stepping on each other.",
  "license": "MIT",
  "server": {
    "entry": "server.wasm",
    "world": "ilium:server/base@0.1.0"
  },
  "client": {
    "entry": "client.wasm",
    "world": "ilium:client/base@0.1.0"
  },
  "capabilities": {
    "server": [
      "workspace.manage",
      "process.run:git",
      "process.run:sh",
      "panes.create",
      "panes.read",
      "fs.read:project",
      "fs.write:worktrees",
      "settings.read-kernel:git",
      "extensions.provide:ilium.core.worktrees/before-create",
      "extensions.provide:ilium.core.worktrees/post-create-steps",
      "extensions.provide:ilium.core.worktrees/before-remove"
    ],
    "client": [
      "ui.panels",
      "settings.write-kernel:git"
    ]
  },
  "activation": [
    "command:ilium.core.worktrees/new-agent",
    "service:create"
  ],
  "contributes": {
    "commands": [
      {
        "id": "new-agent",
        "title": "New agent in worktree",
        "category": "Git"
      }
    ],
    "keybindings": [
      {
        "command": "new-agent",
        "chord": "W",
        "mode": "prefix"
      }
    ],
    "extension_points": [
      {
        "id": "before-create",
        "kind": "hook",
        "mode": "transform",
        "title": "Choose the branch name or refuse a new worktree",
        "payload_schema": {
          "type": "object",
          "properties": {
            "repo": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            },
            "base": {
              "type": "string"
            },
            "agent": {
              "type": "string"
            }
          },
          "required": [
            "repo",
            "branch",
            "base",
            "agent"
          ]
        },
        "reply_schema": {
          "type": "object",
          "properties": {
            "branch": {
              "type": "string"
            }
          },
          "required": [
            "branch"
          ]
        },
        "risk": "standard",
        "deadline_ms": 20,
        "max_handlers": 8,
        "version": "0.1.0"
      },
      {
        "id": "post-create-steps",
        "kind": "collect",
        "title": "Add a step that runs after a worktree is created",
        "entry_schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "working_directory": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "command",
            "working_directory"
          ]
        },
        "risk": "high",
        "max_entries": 64,
        "dynamic": false,
        "version": "0.1.0"
      },
      {
        "id": "before-remove",
        "kind": "hook",
        "mode": "veto",
        "title": "Refuse removing a worktree",
        "payload_schema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            },
            "dirty": {
              "type": "boolean"
            },
            "merged": {
              "type": "boolean"
            }
          },
          "required": [
            "path",
            "branch",
            "dirty",
            "merged"
          ]
        },
        "risk": "standard",
        "deadline_ms": 20,
        "max_handlers": 8,
        "version": "0.1.0"
      }
    ]
  },
  "limits_tier": "first-party"
}
