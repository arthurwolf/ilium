{
  "api": "ilium:plugin@0.1.0",
  "id": "ilium.core.layout",
  "name": "Layout",
  "version": "0.1.0",
  "publisher": "Ilium",
  "description": "The Layout plugin (ilium.core.layout, side both) owns split views and the arrangement of panes on screen: splitting four ways, mixed splits of terminal, editor and board panes, focus and navigation, and resizing with the mouse.",
  "license": "MIT",
  "server": {
    "entry": "server.wasm",
    "world": "ilium:server/base@0.1.0"
  },
  "client": {
    "entry": "client.wasm",
    "world": "ilium:client/base@0.1.0"
  },
  "capabilities": {
    "server": [
      "panes.read",
      "panes.lifecycle",
      "panes.create",
      "tree.restructure",
      "extensions.provide:ilium.core.layout/layout-presets",
      "extensions.provide:ilium.core.layout/before-split"
    ],
    "client": [
      "panes.read",
      "tree.read",
      "agent.read",
      "ui.panels"
    ]
  },
  "contributes": {
    "extension_points": [
      {
        "id": "layout-presets",
        "kind": "collect",
        "title": "Layout presets",
        "entry_schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "template": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "template"
          ]
        },
        "risk": "standard",
        "max_entries": 64,
        "dynamic": false,
        "version": "0.1.0"
      },
      {
        "id": "before-split",
        "kind": "hook",
        "mode": "veto",
        "title": "Before split",
        "payload_schema": {
          "type": "object",
          "properties": {
            "node": {
              "type": "string"
            },
            "direction": {
              "type": "string"
            },
            "pane_count": {
              "type": "integer"
            }
          },
          "required": [
            "node",
            "direction",
            "pane_count"
          ]
        },
        "risk": "standard",
        "deadline_ms": 20,
        "max_handlers": 8,
        "version": "0.1.0"
      }
    ],
    "commands": [
      {
        "id": "preset",
        "title": "Apply layout preset"
      },
      {
        "id": "new-split",
        "title": "New split view"
      },
      {
        "id": "tree-layout",
        "title": "Tree row layout"
      }
    ],
    "panels": [
      {
        "id": "presets",
        "title": "Layout presets"
      }
    ],
    "settings": [
      {
        "kind": "tab",
        "id": "padding",
        "title": "Padding",
        "sections": [
          {
            "id": "padding-mode",
            "title": "When padding applies",
            "scope": "client",
            "rows": [
              {
                "type": "choice",
                "key": "mode",
                "title": "Padding",
                "default": "disabled",
                "options": [
                  {
                    "value": "disabled",
                    "title": "Disabled"
                  },
                  {
                    "value": "width_dependent",
                    "title": "Size dependent"
                  },
                  {
                    "value": "enabled",
                    "title": "Enabled"
                  }
                ]
              },
              {
                "type": "number",
                "key": "width_threshold",
                "title": "Minimum terminal width",
                "minimum": 11,
                "maximum": 1000,
                "step": 1,
                "unit": "columns",
                "default": 200
              },
              {
                "type": "toggle",
                "key": "right_panels_shared",
                "title": "Same padding for every right-hand panel",
                "default": true
              }
            ]
          },
          {
            "id": "padding-tree",
            "title": "Tree",
            "scope": "client",
            "rows": [
              {
                "type": "toggle",
                "key": "tree_linked",
                "title": "Same padding on every side",
                "default": true
              },
              {
                "type": "number",
                "key": "tree_all",
                "title": "Padding on every side",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "tree_left",
                "title": "Left padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "tree_right",
                "title": "Right padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "tree_top",
                "title": "Top padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "tree_bottom",
                "title": "Bottom padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              }
            ]
          },
          {
            "id": "padding-right-shared",
            "title": "Right-hand panels (shared)",
            "scope": "client",
            "rows": [
              {
                "type": "toggle",
                "key": "right_shared_linked",
                "title": "Same padding on every side",
                "default": true
              },
              {
                "type": "number",
                "key": "right_shared_all",
                "title": "Padding on every side",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "right_shared_left",
                "title": "Left padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "right_shared_right",
                "title": "Right padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "right_shared_top",
                "title": "Top padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "right_shared_bottom",
                "title": "Bottom padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              }
            ]
          },
          {
            "id": "padding-terminal",
            "title": "Terminals and agents",
            "scope": "client",
            "rows": [
              {
                "type": "toggle",
                "key": "terminal_linked",
                "title": "Same padding on every side",
                "default": true
              },
              {
                "type": "number",
                "key": "terminal_all",
                "title": "Padding on every side",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "terminal_left",
                "title": "Left padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "terminal_right",
                "title": "Right padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "terminal_top",
                "title": "Top padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "terminal_bottom",
                "title": "Bottom padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              }
            ]
          },
          {
            "id": "padding-editor",
            "title": "Editors",
            "scope": "client",
            "rows": [
              {
                "type": "toggle",
                "key": "editor_linked",
                "title": "Same padding on every side",
                "default": true
              },
              {
                "type": "number",
                "key": "editor_all",
                "title": "Padding on every side",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "editor_left",
                "title": "Left padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "editor_right",
                "title": "Right padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "editor_top",
                "title": "Top padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "editor_bottom",
                "title": "Bottom padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              }
            ]
          },
          {
            "id": "padding-board",
            "title": "Kanban boards",
            "scope": "client",
            "rows": [
              {
                "type": "toggle",
                "key": "board_linked",
                "title": "Same padding on every side",
                "default": true
              },
              {
                "type": "number",
                "key": "board_all",
                "title": "Padding on every side",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "board_left",
                "title": "Left padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "board_right",
                "title": "Right padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "board_top",
                "title": "Top padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              },
              {
                "type": "number",
                "key": "board_bottom",
                "title": "Bottom padding",
                "minimum": 0,
                "maximum": 3,
                "step": 1,
                "unit": "cells",
                "default": 1
              }
            ]
          }
        ]
      },
      {
        "kind": "section",
        "id": "tree-layout",
        "tab": "user-interface",
        "placement": "end",
        "title": "Tree rows",
        "scope": "client",
        "rows": [
          {
            "type": "choice",
            "key": "tree_row_preset",
            "title": "Tree row layout",
            "default": "default",
            "options": [
              {
                "value": "default",
                "title": "Default"
              },
              {
                "value": "all_right",
                "title": "All right"
              },
              {
                "value": "mixed",
                "title": "Mixed"
              }
            ]
          }
        ]
      }
    ]
  },
  "activation": [
    "command:ilium.core.layout/preset",
    "command:ilium.core.layout/new-split",
    "command:ilium.core.layout/tree-layout",
    "view:ilium.core.layout/presets"
  ],
  "limits_tier": "first-party"
}
