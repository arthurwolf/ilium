{
  "api": "ilium:plugin@0.1.0",
  "id": "ilium.core.layout",
  "name": "Layout",
  "version": "0.1.0",
  "publisher": "Ilium",
  "description": "The Layout plugin (ilium.core.layout, side both) owns split views and the arrangement of panes on screen: splitting four ways, mixed splits of terminal, editor and board panes, focus and navigation, and resizing with the mouse.",
  "license": "MIT",
  "server": {
    "entry": "server.wasm",
    "world": "ilium:server/base@0.1.0"
  },
  "client": {
    "entry": "client.wasm",
    "world": "ilium:client/base@0.1.0"
  },
  "capabilities": {
    "server": [
      "panes.read",
      "panes.lifecycle",
      "panes.create",
      "tree.restructure",
      "extensions.provide:ilium.core.layout/layout-presets",
      "extensions.provide:ilium.core.layout/before-split"
    ],
    "client": [
      "panes.read",
      "tree.read",
      "agent.read",
      "ui.panels"
    ]
  },
  "contributes": {
    "extension_points": [
      {
        "id": "layout-presets",
        "kind": "collect",
        "title": "Layout presets",
        "entry_schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "template": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "template"
          ]
        },
        "risk": "standard",
        "max_entries": 64,
        "dynamic": false,
        "version": "0.1.0"
      },
      {
        "id": "before-split",
        "kind": "hook",
        "mode": "veto",
        "title": "Before split",
        "payload_schema": {
          "type": "object",
          "properties": {
            "node": {
              "type": "string"
            },
            "direction": {
              "type": "string"
            },
            "pane_count": {
              "type": "integer"
            }
          },
          "required": [
            "node",
            "direction",
            "pane_count"
          ]
        },
        "risk": "standard",
        "deadline_ms": 20,
        "max_handlers": 8,
        "version": "0.1.0"
      }
    ],
    "commands": [
      {
        "id": "preset",
        "title": "Apply layout preset"
      },
      {
        "id": "new-split",
        "title": "New split view"
      }
    ],
    "panels": [
      {
        "id": "presets",
        "title": "Layout presets"
      }
    ],
    "settings": [
      {
        "kind": "tab",
        "id": "padding",
        "title": "Padding",
        "scope": "client",
        "rows": [
          {
            "type": "choice",
            "key": "mode",
            "title": "Padding",
            "default": "disabled",
            "options": [
              {
                "value": "disabled",
                "title": "Disabled"
              },
              {
                "value": "width_dependent",
                "title": "Size dependent"
              },
              {
                "value": "enabled",
                "title": "Enabled"
              }
            ]
          },
          {
            "type": "number",
            "key": "width_threshold",
            "title": "Minimum terminal width",
            "minimum": 11,
            "maximum": 1000,
            "step": 1,
            "unit": "columns",
            "default": 200
          },
          {
            "type": "toggle",
            "key": "right_panels_shared",
            "title": "Same padding for every right-hand panel",
            "default": true
          },
          {
            "type": "number",
            "key": "tree_all",
            "title": "Tree padding",
            "minimum": 0,
            "maximum": 3,
            "step": 1,
            "unit": "cells",
            "default": 1
          },
          {
            "type": "number",
            "key": "right_shared_all",
            "title": "Right-hand panels padding",
            "minimum": 0,
            "maximum": 3,
            "step": 1,
            "unit": "cells",
            "default": 1
          }
        ]
      },
      {
        "kind": "section",
        "id": "tree-layout",
        "tab": "user-interface",
        "placement": "end",
        "title": "Tree rows",
        "scope": "client",
        "rows": [
          {
            "type": "choice",
            "key": "tree_row_preset",
            "title": "Tree row layout",
            "default": "default",
            "options": [
              {
                "value": "default",
                "title": "Default"
              },
              {
                "value": "all_right",
                "title": "All right"
              },
              {
                "value": "mixed",
                "title": "Mixed"
              }
            ]
          }
        ]
      }
    ]
  },
  "activation": [
    "command:ilium.core.layout/preset",
    "command:ilium.core.layout/new-split",
    "view:ilium.core.layout/presets"
  ],
  "limits_tier": "first-party"
}
