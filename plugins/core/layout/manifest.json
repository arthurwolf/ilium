{
  "api": "ilium:plugin@0.1.0",
  "id": "ilium.core.layout",
  "name": "Layout",
  "version": "0.1.0",
  "publisher": "Ilium",
  "description": "The Layout plugin (ilium.core.layout, side both) owns split views and the arrangement of panes on screen: splitting four ways, mixed splits of terminal, editor and board panes, focus and navigation, and resizing with the mouse.",
  "license": "MIT",
  "server": {
    "entry": "server.wasm",
    "world": "ilium:server/base@0.1.0"
  },
  "client": {
    "entry": "client.wasm",
    "world": "ilium:client/base@0.1.0"
  },
  "capabilities": {
    "server": [
      "panes.read",
      "panes.lifecycle",
      "panes.create",
      "tree.restructure",
      "extensions.provide:ilium.core.layout/layout-presets",
      "extensions.provide:ilium.core.layout/before-split"
    ],
    "client": [
      "panes.read",
      "ui.panels"
    ]
  },
  "contributes": {
    "extension_points": [
      {
        "id": "layout-presets",
        "kind": "collect",
        "title": "Layout presets",
        "entry_schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "template": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "template"
          ]
        },
        "risk": "standard",
        "max_entries": 64,
        "dynamic": false,
        "version": "0.1.0"
      },
      {
        "id": "before-split",
        "kind": "hook",
        "mode": "veto",
        "title": "Before split",
        "payload_schema": {
          "type": "object",
          "properties": {
            "node": {
              "type": "string"
            },
            "direction": {
              "type": "string"
            },
            "pane_count": {
              "type": "integer"
            }
          },
          "required": [
            "node",
            "direction",
            "pane_count"
          ]
        },
        "risk": "standard",
        "deadline_ms": 20,
        "max_handlers": 8,
        "version": "0.1.0"
      }
    ]
  },
  "activation": [
    "command:layout.preset",
    "view:layout.presets"
  ],
  "limits_tier": "first-party"
}
