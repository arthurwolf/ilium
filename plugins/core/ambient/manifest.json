{
  "api": "ilium:plugin@0.1.0",
  "id": "ilium.core.ambient",
  "name": "Ambient look",
  "version": "0.1.0",
  "publisher": "Ilium",
  "description": "The Ambient look plugin (id ilium.core.ambient, sides: client and server) is the plugin form of the shared look of animated backgrounds.",
  "license": "MIT",
  "server": {
    "entry": "server.wasm",
    "world": "ilium:server/base@0.1.0",
    "exports": [
      "service-provider"
    ]
  },
  "client": {
    "entry": "client.wasm",
    "world": "ilium:client/base@0.1.0",
    "exports": [
      "views"
    ]
  },
  "capabilities": {
    "client": [
      "location.geocode",
      "media.video",
      "ui.panels",
      "services.use:ilium.core.ambient/set-setting",
      "extensions.provide:ilium.core.ambient/palettes",
      "extensions.provide:ilium.core.ambient/style-presets"
    ],
    "server": [
      "services.provide:ilium.core.ambient/set-setting",
      "settings.write-kernel:animations"
    ]
  },
  "activation": [
    "startup"
  ],
  "unstable": [
    "plugin-services"
  ],
  "contributes": {
    "extension_points": [
      {
        "id": "palettes",
        "kind": "collect",
        "title": "Palettes",
        "entry_schema": {
          "type": "object",
          "required": [
            "id",
            "title",
            "stops"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "stops": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "risk": "standard",
        "max_entries": 64,
        "dynamic": false,
        "version": "0.1.0"
      },
      {
        "id": "style-presets",
        "kind": "collect",
        "title": "Style presets",
        "entry_schema": {
          "type": "object",
          "required": [
            "id",
            "title",
            "values"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "values": {
              "type": "object"
            }
          }
        },
        "risk": "standard",
        "max_entries": 64,
        "dynamic": false,
        "version": "0.1.0"
      }
    ],
    "services": {
      "provides": [
        {
          "name": "ilium.core.ambient/set-setting",
          "version": "0.1.0",
          "schema": "schemas/set-setting.json"
        }
      ]
    },
    "panels": [
      {
        "id": "gallery",
        "title": "Scenes",
        "modal": false
      }
    ],
    "settings": [
      {
        "kind": "tab",
        "id": "animations",
        "title": "Animations",
        "sections": [
          {
            "id": "look",
            "title": "Look",
            "scope": "client",
            "rows": [
              {
                "type": "choice",
                "key": "scene",
                "title": "Scene",
                "default": "stars",
                "options": [
                  {
                    "value": "stars",
                    "title": "Stars"
                  },
                  {
                    "value": "clouds",
                    "title": "Clouds"
                  }
                ]
              },
              {
                "type": "preview",
                "view": "scene-preview",
                "height": 4,
                "live": true
              },
              {
                "type": "toggle",
                "key": "semantic",
                "title": "Semantic animation",
                "default": false
              },
              {
                "type": "location",
                "key": "observer",
                "title": "Observer location",
                "search": true,
                "allow_current": true,
                "precision": 4,
                "default": {
                  "lat": 38.7223,
                  "lon": -9.1393,
                  "label": "Lisbon"
                }
              },
              {
                "type": "map",
                "key": "saved_places",
                "title": "Saved places",
                "value_type": "string",
                "key_pattern": "^[a-z-]{1,24}$",
                "max_entries": 8,
                "key_title": "Name",
                "value_title": "Label",
                "default": {}
              }
            ]
          }
        ]
      }
    ]
  },
  "limits_tier": "first-party"
}
