{
  "api": "ilium:plugin@0.1.0",
  "id": "ilium.core.search",
  "name": "Search",
  "version": "0.1.0",
  "publisher": "Ilium",
  "description": "The Workspace search plugin (id ilium.core.search, sides: server and client) is the plugin form of Ilium's workspace search.",
  "license": "MIT",
  "server": {
    "entry": "server.wasm",
    "world": "ilium:server/base@0.1.0",
    "exports": [
      "job-runner"
    ]
  },
  "client": {
    "entry": "client.wasm",
    "world": "ilium:client/base@0.1.0",
    "exports": [
      "views"
    ]
  },
  "capabilities": {
    "server": [
      "inference.embed",
      "tree.read",
      "terminal.read-screen",
      "fs.read:project",
      "jobs.run",
      "extensions.provide:ilium.core.search/sources",
      "extensions.provide:ilium.core.search/rank"
    ],
    "client": [
      "ui.panels"
    ]
  },
  "activation": [
    "command:ilium.core.search/open",
    "view:ilium.core.search/search"
  ],
  "contributes": {
    "extension_points": [
      {
        "id": "sources",
        "kind": "collect",
        "title": "Search sources",
        "entry_schema": {
          "type": "object",
          "required": [
            "id",
            "title",
            "kind",
            "service"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "service": {
              "type": "string"
            }
          }
        },
        "risk": "standard",
        "max_entries": 64,
        "dynamic": false,
        "version": "0.1.0"
      },
      {
        "id": "rank",
        "kind": "hook",
        "mode": "transform",
        "title": "Rank results",
        "payload_schema": {
          "type": "object",
          "required": [
            "query",
            "hits"
          ],
          "properties": {
            "query": {
              "type": "string"
            },
            "hits": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "score"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "score": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "reply_schema": {
          "type": "object",
          "required": [
            "hits"
          ],
          "properties": {
            "hits": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "score"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "score": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "risk": "standard",
        "deadline_ms": 20,
        "max_handlers": 8,
        "version": "0.1.0"
      }
    ],
    "commands": [
      {
        "id": "open",
        "title": "Search the workspace",
        "category": "Search"
      }
    ],
    "keybindings": [
      {
        "command": "ilium.core.search/open",
        "chord": "f",
        "mode": "prefix"
      }
    ],
    "panels": [
      {
        "id": "search",
        "title": "Search",
        "modal": true
      }
    ],
    "jobs": [
      {
        "kind": "scan-files",
        "deadline_ms": 60000,
        "memory_mib": 128
      }
    ]
  },
  "limits_tier": "first-party"
}
