+//! Native Ilium waits bypass terminal snapshots and Code Mode cell yields.
+//!
+//! Only the logical lifetime differs from ordinary command execution. The
+//! unified-exec handler still owns sandboxing, approvals, cancellation and
+//! process/output custody; Ilium owns monitor progress and terminal outcomes.
+
+use crate::function_tool::FunctionCallError;
+use crate::sandboxing::SandboxPermissions;
+use crate::tools::context::ToolEnvironments;
+use crate::tools::context::ToolInvocation;
+use crate::tools::context::ToolOutput;
+use crate::tools::context::ToolPayload;
+use crate::tools::handlers::ExecCommandHandler;
+use crate::tools::handlers::ExecCommandHandlerOptions;
+use crate::tools::handlers::parse_arguments;
+use crate::tools::handlers::selected_executor;
+use crate::tools::handlers::shell_spec::CommandToolOptions;
+use crate::tools::handlers::shell_spec::create_exec_command_tool_with_environment_id;
+use crate::tools::registry::CoreToolRuntime;
+use crate::tools::registry::PostToolUsePayload;
+use crate::tools::registry::PreToolUsePayload;
+use crate::tools::registry::ToolExecutor;
+use crate::tools::registry::ToolTelemetryTags;
+use codex_protocol::models::AdditionalPermissionProfile;
+use codex_tools::JsonSchema;
+use codex_tools::ToolExposure;
+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+use codex_utils_path_uri::PathUri;
+use serde::Deserialize;
+use serde_json::json;
+
+pub(crate) struct IliumWaitHandler {
+    executor: ExecCommandHandler,
+    options: ExecCommandHandlerOptions,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct IliumWaitArgs {
+    monitor_id: Option<u64>,
+    probe_command: Option<String>,
+    interval_seconds: Option<u32>,
+    sandbox_permissions: Option<SandboxPermissions>,
+    additional_permissions: Option<AdditionalPermissionProfile>,
+    justification: Option<String>,
+    prefix_rule: Option<Vec<String>>,
+}
+
+impl IliumWaitHandler {
+    pub(crate) fn new(options: ExecCommandHandlerOptions) -> Self {
+        Self {
+            executor: ExecCommandHandler::unconditional_wait(options),
+            options,
+        }
+    }
+
+    /// Translate a narrow wait request before entering the existing command path.
+    fn execution_invocation(
+        &self,
+        invocation: &ToolInvocation,
+    ) -> Result<ToolInvocation, FunctionCallError> {
+        let environment = selected_executor(
+            &invocation.environments,
+            &invocation.step_context.environments,
+        )?;
+        if cfg!(windows) || environment.environment.is_remote() {
+            return Err(FunctionCallError::RespondToModel(
+                "ilium_wait requires the local POSIX environment containing the Ilium pane; remote and Windows execution are unsupported".to_string(),
+            ));
+        }
+        let ToolPayload::Function { arguments } = &invocation.payload else {
+            return Err(FunctionCallError::RespondToModel(
+                "ilium_wait requires function arguments".to_string(),
+            ));
+        };
+        let args: IliumWaitArgs = parse_arguments(arguments)?;
+        let command = match (args.monitor_id, args.probe_command) {
+            (Some(monitor_id), None) if args.interval_seconds.is_none() => {
+                format!("ilium progress wait {monitor_id}")
+            }
+            (None, Some(probe_command)) if !probe_command.trim().is_empty() => {
+                let interval = args.interval_seconds.unwrap_or(1);
+                if !(1..=86_400).contains(&interval) {
+                    return Err(FunctionCallError::RespondToModel(
+                        "interval_seconds must be between 1 and 86400".to_string(),
+                    ));
+                }
+                let quoted_probe = shlex::try_quote(&probe_command).map_err(|_| {
+                    FunctionCallError::RespondToModel(
+                        "probe_command cannot contain a NUL byte".to_string(),
+                    )
+                })?;
+                format!(
+                    "ilium progress set --command {quoted_probe} --interval-seconds {interval} --wait"
+                )
+            }
+            _ => {
+                return Err(FunctionCallError::RespondToModel(
+                    "provide exactly one of monitor_id or nonempty probe_command; interval_seconds is only valid with probe_command".to_string(),
+                ));
+            }
+        };
+        let mut execution = invocation.clone();
+        execution.payload = ToolPayload::Function {
+            arguments: json!({
+                "cmd": command,
+                "shell": "/bin/sh",
+                "login": false,
+                "tty": false,
+                "sandbox_permissions": args.sandbox_permissions,
+                "additional_permissions": args.additional_permissions,
+                "justification": args.justification,
+                "prefix_rule": args.prefix_rule,
+            })
+            .to_string(),
+        };
+        Ok(execution)
+    }
+}
+
+impl ToolExecutor<ToolInvocation> for IliumWaitHandler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain("ilium_wait")
+    }
+
+    fn exposure(&self) -> ToolExposure {
+        // A nested Code Mode call would reintroduce its cell yield boundary.
+        ToolExposure::DirectModelOnly
+    }
+
+    fn spec(&self) -> ToolSpec {
+        let ToolSpec::Function(mut spec) = create_exec_command_tool_with_environment_id(
+            CommandToolOptions {
+                exec_permission_approvals_enabled: self.options.exec_permission_approvals_enabled,
+            },
+            false,
+            false,
+        ) else {
+            unreachable!("command tools have function schemas");
+        };
+        let properties = spec.parameters.properties.get_or_insert_default();
+        properties.retain(|name, _| {
+            matches!(
+                name.as_str(),
+                "sandbox_permissions" | "additional_permissions" | "justification" | "prefix_rule"
+            )
+        });
+        properties.insert(
+            "monitor_id".to_string(),
+            JsonSchema::number(Some(
+                "Exact existing Ilium monitor ID. Provide this or probe_command, never both."
+                    .to_string(),
+            )),
+        );
+        properties.insert(
+            "probe_command".to_string(),
+            JsonSchema::string(Some(
+                "Probe command to register with progress set --wait. Provide this or monitor_id, never both. Registration never replaces other monitors.".to_string(),
+            )),
+        );
+        properties.insert(
+            "interval_seconds".to_string(),
+            JsonSchema::number(Some(
+                "Probe interval from 1 to 86400 seconds; only with probe_command. Defaults to 1. This is not a wait deadline.".to_string(),
+            )),
+        );
+        spec.parameters.required = None;
+        spec.name = "ilium_wait".to_string();
+        spec.description = "Wait for one Ilium monitor without an elapsed-time deadline or periodic model wake-ups. Call this tool directly, outside functions.exec/Code Mode. Returns only the actual CLI outcome, interruption or meaningful execution failure. Progress remains visible in Ilium independently. Preserve monitor/job identity on failure; never start a duplicate job because observation was lost. Requires a local POSIX Ilium pane and an Ilium CLI supporting unconditional progress waits.".to_string();
+        spec.output_schema = None;
+        ToolSpec::Function(spec)
+    }
+
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async move {
+            let execution = self.execution_invocation(&invocation)?;
+            self.executor.handle(execution).await
+        })
+    }
+}
+
+impl CoreToolRuntime for IliumWaitHandler {
+    fn environments_for_input(
+        &self,
+        invocation: &ToolInvocation,
+    ) -> Result<ToolEnvironments, FunctionCallError> {
+        self.executor.environments_for_input(invocation)
+    }
+
+    fn telemetry_tags(&self, invocation: &ToolInvocation) -> ToolTelemetryTags {
+        self.executor.telemetry_tags(invocation)
+    }
+
+    fn pre_tool_use_payload(&self, invocation: &ToolInvocation) -> Option<PreToolUsePayload> {
+        self.execution_invocation(invocation)
+            .ok()
+            .and_then(|execution| self.executor.pre_tool_use_payload(&execution))
+    }
+
+    fn pre_tool_use_cwd(
+        &self,
+        invocation: &ToolInvocation,
+    ) -> Result<Option<PathUri>, FunctionCallError> {
+        let execution = self.execution_invocation(invocation)?;
+        self.executor.pre_tool_use_cwd(&execution)
+    }
+
+    fn with_updated_hook_input(
+        &self,
+        invocation: ToolInvocation,
+        updated_input: serde_json::Value,
+    ) -> Result<ToolInvocation, FunctionCallError> {
+        let execution = self.execution_invocation(&invocation)?;
+        let expected = self.executor.pre_tool_use_payload(&execution);
+        if expected.as_ref().map(|payload| &payload.tool_input) != Some(&updated_input) {
+            return Err(FunctionCallError::RespondToModel(
+                "ilium_wait cannot accept a hook rewrite that changes its narrow wait command; change the typed monitor/probe request instead".to_string(),
+            ));
+        }
+        Ok(invocation)
+    }
+
+    fn post_tool_use_payload(
+        &self,
+        invocation: &ToolInvocation,
+        result: &dyn ToolOutput,
+    ) -> Option<PostToolUsePayload> {
+        self.execution_invocation(invocation)
+            .ok()
+            .and_then(|execution| self.executor.post_tool_use_payload(&execution, result))
+    }
+}
