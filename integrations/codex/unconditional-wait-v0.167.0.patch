+#[tokio::test(start_paused = true)]
+async fn ilium_wait_crosses_three_snapshot_boundaries_without_returning() {
+    let output = ilium_wait_test_output();
+    let collect = UnifiedExecProcessManager::collect_output_with_deadline(&output, None, None);
+    tokio::pin!(collect);
+    assert!(futures::poll!(&mut collect).is_pending());
+    for _ in 0..3 {
+        tokio::time::advance(Duration::from_millis(
+            crate::unified_exec::MAX_YIELD_TIME_MS,
+        ))
+        .await;
+        output
+            .output_buffer
+            .lock()
+            .await
+            .push_chunk(ExecOutputStream::Stdout, &[b'x'; 100]);
+        output.output_notify.notify_one();
+        assert!(futures::poll!(&mut collect).is_pending());
+    }
+    output
+        .output_buffer
+        .lock()
+        .await
+        .push_chunk(ExecOutputStream::Stdout, b"terminal-result");
+    output.output_closed.store(true, Ordering::Release);
+    output.cancellation_token.cancel();
+    let collected = collect.await;
+    assert_eq!(collected.retained_bytes(), 32);
+    assert_eq!(collected.total_bytes(), 315);
+    assert!(collected.to_bytes().ends_with(b"terminal-result"));
+    assert!(
+        output
+            .output_buffer
+            .lock()
+            .await
+            .transcript
+            .retained_bytes()
+            <= 32
+    );
+}
