+#[tokio::test]
+async fn ilium_wait_lifetime_keeps_interactive_and_one_shot_contracts() {
+    let (session, turn, _events) = crate::session::tests::make_session_and_context_with_rx().await;
+    let step = crate::session::step_context::StepContext::for_test(Arc::clone(&turn));
+    let environment = turn
+        .initial_environments
+        .primary()
+        .expect("local environment");
+    for (lifetime, wait_until_complete, timeout, tty) in [
+        (ExecCommandLifetime::Interactive, false, None, true),
+        (
+            ExecCommandLifetime::OneShot,
+            false,
+            Some(Duration::from_millis(1234)),
+            false,
+        ),
+        (ExecCommandLifetime::UnconditionalWait, true, None, false),
+    ] {
+        let prepared = ParsedExecCommand::parse(
+            r#"{"cmd":"true","tty":true,"timeout_ms":1234}"#,
+            &session,
+            &step,
+            environment,
+        )
+        .expect("parse request")
+        .prepare(lifetime)
+        .expect("prepare request");
+        assert_eq!(prepared.wait_until_complete, wait_until_complete);
+        assert_eq!(prepared.completion_timeout, timeout);
+        assert_eq!(prepared.tty, tty);
+    }
+}
