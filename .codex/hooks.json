{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ilium chat context --limit 40",
            "timeout": 10,
            "statusMessage": "Checking ilium chatroom"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ilium chat context --limit 40",
            "timeout": 10,
            "statusMessage": "Checking ilium chatroom"
          }
        ]
      }
    ]
  }
}
